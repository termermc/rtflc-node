def backslash = " \\ "
backslash = substring(backslash, 1, 2)

// Method calls with and without parentheses

def str = concat("ab", "cd")
println(str)
println(str.string_length)
def len = str.string_length
len = len.sub(1)
println(len)
if str.ends_with("cd") {
  println("ends-ok")
}
if ![str.ends_with("x")] {
  println("method-logic-ok")
}

// Method call with arguments

def replaced = str.string_replace("bc", "XY")
println(replaced)

def sub = str.substring(1, 3)
println(sub)

def ch = str.char_at(2)
println(ch)

def multiline = "line1\\nline2"
println(multiline)
